# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Local secrets / agent state
.env
.claude/
*.log

# Generated PDFs
output/
cc2026/

# Build artefacts
build/
dist/
*.egg-info/

# Local input data — may contain PII (real officials' names). A local CSV, from
# a published Sheet or hand-written, is for offline development only and must
# not be committed.
officials.csv
*.csv

# …with one carve-out: test fixtures, which are synthetic by rule and have to
# be in git for the tests to run. Nothing real goes in this directory.
!tests/fixtures/*.csv
